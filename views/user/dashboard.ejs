<%- include('../partials/head') %>

    <body>

        <div class="dashboard">

            <%- include('../partials/userSidebar') %>

                <!-- Content -->

                <main class="content">

                    <h1 class="page-title">
                        Дашборд рабочих пространств
                    </h1>

                    <!-- Greeting -->

                    <section class="welcome-card">

                        <h2>
                            Привет, <%= user.username %>!
                        </h2>

                        <p>
                            <span id="time-display"></span> чтобы продолжить работу над своими проектами.
                        </p>

                    </section>

                    <!-- Spaces -->

                    <section class="spaces">

                        <% if (workspaces && workspaces.length> 0) { %>

                            <% workspaces.forEach(workspace=> { %>

                                <article class="space-card">

                                    <div class="space-card__header">

                                        <h3>
                                            <%= workspace.name %>
                                        </h3>

                                        <span>
                                            <%= workspace.task_count %> задач
                                        </span>

                                    </div>


                                    <% if(workspace.activeTasks.length> 0){ %>


                                        <div class="active-tasks">


                                            <p class="active-tasks__title">
                                                В работе
                                            </p>


                                            <% workspace.activeTasks.forEach(task=> { %>


                                                <div class="task-preview">


                                                    <h4>
                                                        <%= task.title %>
                                                    </h4>


                                                    <div class="task-preview__meta">


                                                        <span class="task-status">

                                                            <%= task.status.icon %>

                                                                <%= task.status.label %>

                                                        </span>


                                                        <span class="task-date">

                                                            <%= task.date %>

                                                        </span>


                                                    </div>


                                                </div>


                                                <% }) %>


                                        </div>


                                        <% } else { %>


                                            <div class="empty-task">

                                                Активных задач нет

                                            </div>


                                            <% } %>
                                                <a href="/workspace/<%= workspace.id %>/tasks" class="space-card__link">
                                                    Открыть задачи
                                                    <span>→</span>
                                                </a>

                                </article>

                                <% }) %>

                                    <% } else { %>

                                        <p>У вас нет рабочих пространств. Создайте новое, чтобы начать работу.</p>

                                        <% } %>


                    </section>

                </main>
                <%- include('../modals/createWs') %>
        </div>
        <%- include("../partials/toast") %>
    </body>

    </html>