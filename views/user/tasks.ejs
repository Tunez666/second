<%- include('../partials/head') %>

    <body>

        <div class="dashboard">

            <%- include('../partials/userSidebar') %>

                <main class="content">

                    <div class="tasks-header">

                        <h1 class="page-title">
                            Мои задачи
                        </h1>

                        <button class="btn" data-modal="createTaskModal">

                            + Создать задачу

                        </button>
                    </div>

                    <div class="task-filters">


                        <button class="filter-btn active" data-filter="all">

                            Все

                        </button>


                        <button class="filter-btn" data-filter="todo">

                            Не начато

                        </button>


                        <button class="filter-btn" data-filter="in_progress">

                            В процессе

                        </button>


                        <button class="filter-btn" data-filter="done">

                            Завершено

                        </button>


                    </div>

                    <% if(tasks && tasks.length> 0){ %>

                        <section class="tasks">

                            <% tasks.forEach(task=>{ %>

                                <article class="task-card" data-modal="taskViewModal" data-task-id="<%= task.id %>"
                                    data-status="<%= task.status %>">


                                    <div class="task-card__header">


                                        <div class="task-card__title">


                                            <h3>
                                                <%= task.title %>
                                            </h3>


                                            <span class="task-status">

                                                <%= task.status_formatted.icon %>

                                                    <%= task.status_formatted.label %>

                                            </span>


                                        </div>


                                    </div>



                                    <% if(task.description){ %>

                                        <p class="task-description">

                                            <%= task.description %>

                                        </p>

                                        <% } %>



                                            <div class="task-card__info">


                                                <div class="task-info-item">

                                                    <span>
                                                        Начало
                                                    </span>

                                                    <strong>
                                                        <%= task.start_date_formatted || "Не указано" %>
                                                    </strong>

                                                </div>



                                                <div class="task-info-item">

                                                    <span>
                                                        Дедлайн
                                                    </span>

                                                    <strong>
                                                        <%= task.due_date_formatted || "Не указан" %>
                                                    </strong>

                                                </div>



                                                <div class="task-info-item">

                                                    <span>
                                                        Весь день
                                                    </span>

                                                    <strong>
                                                        <%= task.all_day ? "Да" : "Нет" %>
                                                    </strong>

                                                </div>


                                            </div>


                                </article>

                                <% }) %>

                        </section>

                        <% } else { %>

                            <section class="empty-state">

                                <h2>
                                    Пока задач нет
                                </h2>

                                <p>

                                    Создайте первую задачу для выбранного пространства.

                                </p>

                                <button class="btn" data-modal="createTaskModal">

                                    Создать задачу

                                </button>

                            </section>

                            <% } %>

                </main>

        </div>
        <%- include('../modals/createWs') %>
            <%- include('../modals/viewEdTask') %>
                <%- include('../modals/confirmModal') %>
                    <%- include("../modals/createTaskModal") %>
                        <%- include("../partials/toast") %>

    </body>

    </html>