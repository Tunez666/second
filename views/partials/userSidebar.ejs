<aside class="sidebar">

    <div class="sidebar__logo">
        🌿 <span>LifeTree</span>
    </div>

    <div class="sidebar__workspace">

        <label>Сейчас работаю над</label>

        <form action="/workspace/select" method="POST">

            <input type="hidden" name="redirect" value="<%= currentPath %>">

            <select id="workspace-select" name="workspaceId" onchange="this.form.submit()">


                <option value="">
                    Выберите пространство
                </option>


                <% workspaces.forEach(workspace=> { %>

                    <option value="<%= workspace.id %>" <%=String(workspace.id)===String(workspaceId) ? "selected" : ""
                        %>
                        >

                        <%= workspace.name %>

                    </option>


                    <% }) %>


            </select>
        </form>
    </div>

    <nav class="sidebar__nav">

        <a href="/dashboard"> Дашборд</a>
        <a href="/tasks"> Мои задачи</a>

        <a href="/notes/<%= currentWorkspace %>"> Мои заметки</a>
        <a href="/calendar/<%= currentWorkspace %>"> Календарь</a>
        <a href="/knowledge-base/<%= currentWorkspace %>"> База знаний</a>
        <a href="/statistics/<%= currentWorkspace %>"> Статистика</a>
        <a href="/settings"> Настройки</a>

        <button id="theme-toggle" class="theme-toggle">
            🌙
        </button>

    </nav>

    <div class="sidebar__footer">

        <button class="btn btn-primary" data-modal="createWorkspaceModal">
            + Создать пространство
        </button>

    </div>

</aside>
